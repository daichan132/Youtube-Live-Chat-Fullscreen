{
  "name": "youtube-live-chat-fullscreen",
  "private": true,
  "version": "2.3.15",
  "type": "module",
  "scripts": {
    "dev": "wxt --host localhost",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:e2e": "wxt build --mode testing",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit:chrome:v2": "node scripts/cws-v2-submit.mjs",
    "submit:firefox": "wxt submit --firefox-extension-id youtube-live-chat-fullscreen",
    "compile": "tsc --noEmit",
    "locales:check": "node scripts/verify/check-locales.mjs",
    "store:check": "node scripts/verify/check-store-listing.mjs",
    "postinstall": "wxt prepare",
    "format": "biome format --write ./entrypoints ./shared",
    "check": "biome check ./entrypoints ./shared && tsc --noEmit && node scripts/verify/check-release-workflow.mjs",
    "fix": "biome check --write ./entrypoints ./shared",
    "lint": "yarn check",
    "test:unit": "vitest run",
    "test:core": "vitest run --project core",
    "test:dom": "vitest run --project dom",
    "test:contracts": "vitest run --project contracts",
    "test:coverage": "vitest run --coverage --project core --project dom",
    "test:package": "yarn zip && yarn zip:firefox && yarn verify:package-contracts",
    "prepare": "lefthook install",
    "e2e": "yarn e2e:fixture",
    "e2e:fixture": "yarn build:e2e && playwright test --project=fixture",
    "e2e:canary": "yarn build:e2e && playwright test --project=canary",
    "e2e:production:chrome": "yarn prepare:production-smoke && YLC_EXTENSION_OUTPUT_DIR=.output/production-smoke/chrome YLC_REQUIRE_E2E_BRIDGE=0 playwright test --project=production-chrome --retries=0",
    "e2e:archive": "yarn build:e2e && playwright test --project=canary --grep @archive",
    "e2e:live": "yarn build:e2e && playwright test --project=canary --grep @live",
    "test:visual": "yarn build:e2e && playwright test --project=visual",
    "test:accessibility": "yarn build:e2e && playwright test --project=accessibility",
    "capture:store-assets": "yarn build:e2e && playwright test --project=store-assets --workers=1",
    "screenshots": "yarn capture:store-assets",
    "verify:browser": "node scripts/verify/launch-browser.mjs",
    "verify:chrome": "node scripts/verify/launch-chrome.mjs",
    "verify:release-workflow": "node scripts/verify/check-release-workflow.mjs",
    "verify:dev": "node scripts/verify/launch-chrome.mjs --dev --setup-extension",
    "verify:overlay": "node scripts/verify/inspect-overlay.mjs",
    "verify:package-contracts": "node scripts/verify/check-package-contracts.mjs",
    "verify:screenshots": "node scripts/verify/capture-overlay-screenshots.mjs",
    "prepare:production-smoke": "node scripts/verify/prepare-production-smoke.mjs",
    "create:release-proof": "node scripts/verify/release-proof.mjs create",
    "verify:release-proof": "node scripts/verify/release-proof.mjs verify",
    "verify": "yarn locales:check && yarn store:check && yarn check && yarn test:coverage && yarn test:contracts",
    "verify:firefox-source": "node scripts/verify/rebuild-firefox-source.mjs",
    "verify:release": "yarn verify && yarn test:package && yarn verify:firefox-source && yarn build:e2e && playwright test --project=fixture --project=visual --project=accessibility --retries=0 --max-failures=1 && yarn e2e:production:chrome && YLC_EXTENSION_OUTPUT_DIR=.output/production-smoke/chrome YLC_REQUIRE_E2E_BRIDGE=0 YLC_CANARY_REQUIRE_CLEAN=1 playwright test --project=canary --retries=0 --max-failures=1"
  },
  "dependencies": {
    "jotai": "^2.12.5",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.10",
    "@fontsource/inter": "5.3.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/chrome": "0.2.8",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "30.0.1",
    "lefthook": "2.1.10",
    "playwright-core": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "wxt": "0.21.4"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "lefthook": {
      "built": true
    }
  },
  "resolutions": {
    "@isaacs/brace-expansion": "5.0.1",
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "defu": "6.1.7",
    "fx-runner": "1.6.0",
    "glob": "13.0.6",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch@npm:^3.0.4": "3.1.5",
    "node-forge": "1.4.0",
    "picomatch@npm:^2.3.1": "4.0.7",
    "picomatch@npm:^4.0.3": "4.0.7",
    "shell-quote": "1.10.0",
    "socks": "2.8.9",
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "undici": "8.10.0",
    "uuid": "11.1.1",
    "vite": "8.2.2"
  },
  "packageManager": "yarn@4.18.0",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ]
}
