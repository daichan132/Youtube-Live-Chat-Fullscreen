{
  "name": "youtube-live-chat-fullscreen",
  "private": true,
  "version": "2.3.12",
  "type": "module",
  "scripts": {
    "dev": "wxt --host localhost",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:e2e": "wxt build --mode testing",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit:chrome:v2": "node scripts/cws-v2-submit.mjs",
    "compile": "tsc --noEmit",
    "locales:check": "node scripts/verify/check-locales.mjs",
    "size:check": "node scripts/verify/check-package-size.mjs",
    "postinstall": "wxt prepare",
    "format": "biome format --write ./entrypoints ./shared",
    "check": "biome check ./entrypoints ./shared && tsc --noEmit && node scripts/verify/check-release-workflow.mjs",
    "fix": "biome check --write ./entrypoints ./shared",
    "lint": "yarn check",
    "test:unit": "vitest run",
    "test:core": "vitest run --project core",
    "test:dom": "vitest run --project dom",
    "test:contracts": "vitest run --project contracts",
    "test:coverage": "vitest run --coverage --project core --project dom && vitest run --project contracts tests/coverage.contract.spec.ts",
    "test:package": "yarn build && yarn build:firefox && yarn zip && yarn zip:firefox && yarn verify:package-contracts",
    "prepare": "lefthook install",
    "e2e": "yarn e2e:fixture",
    "e2e:fixture": "yarn build:e2e && playwright test --project=fixture",
    "e2e:canary": "yarn build:e2e && playwright test --project=canary",
    "e2e:archive": "yarn build:e2e && playwright test --project=canary --grep @archive",
    "e2e:live": "yarn build:e2e && playwright test --project=canary --grep @live",
    "test:visual": "yarn build:e2e && playwright test --project=visual",
    "test:accessibility": "yarn build:e2e && playwright test --project=accessibility",
    "capture:store-assets": "yarn build:e2e && playwright test --project=store-assets --workers=1",
    "screenshots": "yarn capture:store-assets",
    "verify:browser": "node scripts/verify/launch-browser.mjs",
    "verify:chrome": "node scripts/verify/launch-chrome.mjs",
    "verify:release-workflow": "node scripts/verify/check-release-workflow.mjs",
    "verify:dependency-age": "node scripts/verify/check-lockfile-age.mjs",
    "verify:dev": "node scripts/verify/launch-chrome.mjs --dev --setup-extension",
    "verify:overlay": "node scripts/verify/inspect-overlay.mjs",
    "verify:package-contracts": "node scripts/verify/check-package-contracts.mjs",
    "verify:screenshots": "node scripts/verify/capture-overlay-screenshots.mjs"
  },
  "dependencies": {
    "jotai": "^2.12.5",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "2.5.5",
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "0.2.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "@wxt-dev/module-react": "1.2.2",
    "jsdom": "29.1.1",
    "lefthook": "2.1.10",
    "playwright-core": "1.61.1",
    "tailwindcss": "^4.1.11",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wxt": "0.20.27"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "lefthook": {
      "built": true
    }
  },
  "resolutions": {
    "@isaacs/brace-expansion": "5.0.1",
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.7",
    "defu": "6.1.7",
    "fx-runner": "1.5.0",
    "glob": "13.0.6",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch@npm:^3.0.4": "3.1.5",
    "node-forge": "1.4.0",
    "picomatch@npm:^2.3.1": "4.0.5",
    "picomatch@npm:^4.0.3": "4.0.5",
    "shell-quote": "1.10.0",
    "socks": "2.8.9",
    "tar": "7.5.20",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "vite": "8.1.5"
  },
  "packageManager": "yarn@4.17.1",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ]
}
