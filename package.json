{
  "name": "youtube-live-chat-fullscreen",
  "private": true,
  "version": "2.3.10",
  "type": "module",
  "scripts": {
    "dev": "wxt --host localhost",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "submit:chrome:v2": "node scripts/cws-v2-submit.mjs",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "format": "biome format --write ./entrypoints ./shared",
    "check": "biome check ./entrypoints ./shared && tsc --noEmit",
    "fix": "biome check --write ./entrypoints ./shared",
    "lint": "yarn check",
    "test:unit": "vitest run",
    "prepare": "lefthook install",
    "e2e": "playwright test --project=e2e",
    "e2e:archive": "playwright test --project=e2e --grep @archive",
    "e2e:live": "playwright test --project=e2e --grep @live",
    "screenshots": "playwright test --project=screenshots --workers=1",
    "verify:browser": "node scripts/verify/launch-browser.mjs",
    "verify:chrome": "node scripts/verify/launch-chrome.mjs",
    "verify:dependency-age": "node scripts/verify/check-lockfile-age.mjs",
    "verify:dev": "node scripts/verify/launch-chrome.mjs --dev --setup-extension",
    "verify:overlay": "node scripts/verify/inspect-overlay.mjs",
    "verify:screenshots": "node scripts/verify/capture-overlay-screenshots.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "re-resizable": "^6.11.2",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.10",
    "redux-persist-webextension-storage": "^1.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/chrome": "0.2.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/redux-persist-webextension-storage": "1.0.3",
    "@wxt-dev/module-react": "1.2.2",
    "@wxt-dev/unocss": "1.0.1",
    "jsdom": "29.1.1",
    "lefthook": "2.1.10",
    "typescript": "7.0.2",
    "unocss": "66.7.5",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wxt": "0.20.27"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "lefthook": {
      "built": true
    }
  },
  "resolutions": {
    "@isaacs/brace-expansion": "5.0.1",
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.7",
    "defu": "6.1.7",
    "fx-runner": "1.5.0",
    "glob": "13.0.6",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
    "minimatch@npm:^3.0.4": "3.1.5",
    "node-forge": "1.4.0",
    "picomatch@npm:^2.3.1": "4.0.5",
    "picomatch@npm:^4.0.3": "4.0.5",
    "shell-quote": "1.10.0",
    "socks": "2.8.9",
    "tar": "7.5.20",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "vite": "8.1.5"
  },
  "packageManager": "yarn@4.17.1",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ]
}
